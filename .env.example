# ---- Backend ----
# Comma-separated key pool (at least 2). Ids become key_1, key_2, ... in this order.
LLM_API_KEYS=your-first-api-key,your-second-api-key
# Any LiteLLM model name that matches your keys (e.g. gemini/gemini-2.5-flash, groq/llama-3.3-70b-versatile)
LLM_MODEL=gemini/gemini-2.5-flash
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_FAILURE_SIMULATION=true
# Optional tuning
CACHE_TYPE=local            # local (in-memory) or disk (persists in /data/llm_cache)
CACHE_DIR=/data/llm_cache
KEY_COOLDOWN_SECONDS=30
REQUEST_TIMEOUT_SECONDS=30
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.

# ---- Frontend (build-time) ----
# URL the browser uses to reach the backend
VITE_API_URL=http://localhost:8000
